# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=adportal
POSTGRES_USER=adportal_user
POSTGRES_PASSWORD=strongpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your@email.com

# Frontend
FRONTEND_URL=http://localhost:3000

# Nginx / TLS
FRONTEND_HOSTS=useadportal.com www.useadportal.com
API_HOSTS=api.useadportal.com
CERT_NAME=useadportal.com
CERTBOT_EMAIL=admin@useadportal.com
CERTBOT_DOMAINS=useadportal.com,www.useadportal.com,api.useadportal.com

# Social / Ad Platforms
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OpenAI
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
HTTP_STRIPE_SIGNATURE=

# ── Security / hardening (see docs/CODEBASE_AUDIT.md) ──────────────────────
# SECRET_KEY is REQUIRED when DEBUG is off (use a random 50+ character value).
# Extra browser origins allowed by CORS / WebSocket origin check (comma separated).
# FRONTEND_URL and CSRF_TRUSTED_ORIGINS are included automatically.
CORS_ALLOWED_ORIGINS=
# Only ever set True for local development.
CORS_ALLOW_ALL_ORIGINS=False
USE_HTTPS=True
# Address/CIDR allowed to open /dozzle/ (your VPN / office IP).
DOZZLE_ALLOW=127.0.0.1
# Rate limits (DRF format: N/second|minute|hour|day)
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_AUTH=10/hour
THROTTLE_OTP=10/min
THROTTLE_OTP_SEND=5/hour
THROTTLE_CONTACT=5/hour
THROTTLE_AI=20/min
# Postgres connection reuse (seconds) and Celery task limits (seconds)
DB_CONN_MAX_AGE=60
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=720
FIELD_ENCRYPTION_KEYS=
# Require a password for Redis (cache, channels, Celery). Strongly recommended.
REDIS_PASSWORD=
# Django admin (/admin/) is reachable only from this address/CIDR.
ADMIN_ALLOW=127.0.0.1
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
AI_DAILY_LIMIT_PER_ORG=200
# SameSite for the HttpOnly refresh cookie: Lax (same site, e.g. app.x.com + api.x.com) or None (cross-site, needs HTTPS)
AUTH_COOKIE_SAMESITE=Lax
# Legacy ?token=<JWT> WebSocket auth. Leave False; only enable temporarily while old frontends are still deployed.
WS_ALLOW_QUERY_TOKEN=False
